<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">

<title>Pride Connect</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box}

html,body{
margin:0;
background:#f7f7fb;
color:#171827;
font-family:Arial,sans-serif
}

button,input,textarea{
font:inherit
}

.app{
max-width:430px;
min-height:100vh;
margin:auto;
background:#fafafd
}

.hide{
display:none!important
}

/* TOP */

.top{
height:68px;
background:#fff;
border-bottom:1px solid #ddd;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 10px;
position:sticky;
top:0;
z-index:20
}

.logo{
font-size:21px;
font-weight:800;
background:linear-gradient(90deg,#ef1680,#6420dc);
color:transparent;
background-clip:text
}

.icons{
display:flex;
gap:5px
}

.icon,.nav,.more{
border:0;
background:#fff;
cursor:pointer
}

.icon{
width:43px;
height:42px;
border-radius:11px;
background:#f5f5f8;
font-size:20px
}

/* SCREENS */

.screen{
display:none;
min-height:calc(100vh - 136px);
padding:10px 10px 90px
}

.screen.active{
display:block
}

/* CARD */

.card{
background:#fff;
border:1px solid #e8e8ef;
border-radius:15px;
box-shadow:0 2px 8px #0000000a
}

/* COMPOSER */

.composer{
padding:12px;
display:flex;
gap:10px
}

.avatar{
width:52px;
height:52px;
border-radius:50%;
object-fit:cover;
background:#ddd
}

.compose{
flex:1;
border:2px solid #e7e7ed;
border-radius:11px;
padding:12px
}

.hint{
color:#65697a;
font-size:17px;
margin-bottom:12px
}

.compose textarea{
width:100%;
border:0;
outline:0;
resize:none;
min-height:45px
}

.tools{
display:flex;
align-items:center;
gap:10px
}

.tools button{
border:0;
background:none;
font-size:22px;
cursor:pointer
}

.post{
margin-left:auto;
background:#5d13dc!important;
color:#fff;
border-radius:9px!important;
padding:9px 18px;
font-weight:700
}

/* FEED */

.feed{
margin-top:10px
}

.feed .card{
padding:14px;
margin-bottom:10px
}

.head{
display:flex;
align-items:center;
gap:10px
}

.name{
font-size:18px;
font-weight:800
}

.time{
color:#666;
font-size:13px;
margin-top:4px
}

.msg{
font-size:17px;
line-height:1.45;
margin:20px 0
}

.actions{
border-top:1px solid #eee;
padding-top:10px;
display:grid;
grid-template-columns:repeat(3,1fr)
}

.actions button{
border:0;
background:none;
min-height:42px;
cursor:pointer
}

.nice.liked{
color:#6420dc;
font-weight:700
}

.empty{
text-align:center;
padding:35px 15px;
color:#686b7b
}

/* HERO */

.hero{
padding:18px;
margin-bottom:10px;
background:linear-gradient(135deg,#5d13dc,#8e21e8);
color:#fff;
border-radius:15px
}

.big{
width:100%;
height:48px;
border:0;
border-radius:10px;
background:#5d13dc;
color:#fff;
font-weight:700;
cursor:pointer
}

/* PROFILE */

.profile-banner{
height:72px;
background:linear-gradient(110deg,#4d00e8,#9400e3,#ff7900);
border-radius:15px 15px 0 0
}

.profile-body{
padding:18px
}

.phead{
display:flex;
gap:14px
}

.profile-wrap{
position:relative
}

.profile-wrap .avatar{
width:82px;
height:82px
}

.camera{
position:absolute;
right:-3px;
bottom:-3px;
width:31px;
height:31px;
border-radius:50%;
background:#6420dc;
color:#fff;
border:3px solid #fff;
display:flex;
align-items:center;
justify-content:center;
cursor:pointer
}

.upload{
width:100%;
height:50px;
margin-top:17px;
border:2px solid #6c18df;
background:#fff;
color:#5c13d6;
border-radius:9px;
font-weight:bold;
display:flex;
align-items:center;
justify-content:center;
cursor:pointer
}

/* BOTTOM */

.bottom{
position:fixed;
left:0;
right:0;
bottom:0;
height:68px;
background:#fff;
border-top:1px solid #ddd;
display:grid;
grid-template-columns:repeat(5,1fr);
z-index:30;
max-width:430px;
margin:auto
}

.nav{
font-size:11px;
color:#151722;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
cursor:pointer
}

.nav b{
font-size:23px;
line-height:24px
}

.nav.active{
color:#5d12d8
}

/* AUTH */

.auth{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
background:linear-gradient(135deg,#faf0ff,#fff)
}

.authbox{
width:100%;
max-width:390px;
background:#fff;
padding:24px;
border-radius:20px;
box-shadow:0 8px 30px #0001
}

.authbox h1{
margin-top:0
}

.authbox input{
width:100%;
height:50px;
margin:7px 0;
padding:0 14px;
border:1px solid #ddd;
border-radius:10px
}

.primary,.secondary{
width:100%;
height:50px;
margin-top:10px;
border-radius:10px;
font-weight:700;
cursor:pointer
}

.primary{
border:0;
background:#6415df;
color:#fff
}

.secondary{
border:2px solid #6415df;
background:#fff;
color:#6415df
}

.msgbox{
min-height:20px;
color:#c33;
font-size:13px;
margin:6px 0
}

/* TOAST */

.toast{
position:fixed;
left:50%;
bottom:88px;
transform:translate(-50%,10px);
background:#222;
color:#fff;
padding:11px 15px;
border-radius:9px;
opacity:0;
pointer-events:none;
transition:.2s;
z-index:50
}

.toast.show{
opacity:1;
transform:translate(-50%,0)
}
</style>
</head>

<body>

<!-- AUTH -->

<div id="auth" class="auth">

<div class="authbox">

<h1>
🌈 <span style="color:#6415df">Pride Connect</span>
