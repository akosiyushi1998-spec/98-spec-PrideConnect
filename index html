<div id="toast" class="toast"></div>


<script>

/* =====================================================
   SUPABASE
===================================================== */

const SUPABASE_URL =
'https://uupofonanisdjmmawlml.supabase.co';

const SUPABASE_PUBLISHABLE_KEY =
'sb_publishable_DpZ1Fzh9A6GjblSnRHrAPw__OFGaML_';


const db =
window.supabase.createClient(
SUPABASE_URL,
SUPABASE_PUBLISHABLE_KEY,
{
auth:{
/*
IMPORTANT:
HINDI FALSE.
Dapat TRUE para manatili ang session.
*/
persistSession:true,

autoRefreshToken:true,

detectSessionInUrl:true
}
});


const FALLBACK =
'https://placehold.co/160x160/png?text=YU';

let toastTimer;


/* =====================================================
   TOAST
===================================================== */

function toast(message){

const element =
document.getElementById('toast');

element.textContent=message;

element.classList.add('show');

clearTimeout(toastTimer);

toastTimer=setTimeout(
()=>{
element.classList.remove('show');
},
1700
);

}


/* =====================================================
   SCREEN
===================================================== */

function openScreen(id,button){

document
.querySelectorAll('.screen')
.forEach(screen=>{
screen.classList.remove('active');
});


const target =
document.getElementById(id);

if(target){
target.classList.add('active');
}


document
.querySelectorAll('.nav')
.forEach(nav=>{
nav.classList.remove('active');
});


if(button){
button.classList.add('active');
}


window.scrollTo(0,0);

}


/* =====================================================
   AVATARS
===================================================== */

function setAvatars(url){

const finalUrl =
url || FALLBACK;


[
'homeAvatar',
'profileImage'
]
.forEach(id=>{

const image =
document.getElementById(id);

if(image){
image.src=finalUrl;
}

});

}


/* =====================================================
   CURRENT USER
===================================================== */

async function currentUser(){

try{

const result =
await db.auth.getUser();

return result.data?.user || null;

}catch(error){

console.error(
'currentUser error:',
error
);

return null;

}

}


/* =====================================================
   PROFILE
===================================================== */

async function loadProfile(){

const user =
await currentUser();

if(!user){
return;
}


let data=null;


try{

const result =
await db
.from('profiles')
.select(
'display_name,username,avatar_url'
)
.eq('id',user.id)
.maybeSingle();


data=result.data;

}catch(error){

console.error(
'Profile load error:',
error
);

}


/*
If profile doesn't exist,
create it.
*/

if(!data){

const name =
user.user_metadata?.display_name ||
user.email?.split('@')[0] ||
'User';


const username =
(
'u' +
user.id
.replace(/-/g,'')
.slice(0,10)
)
.toLowerCase();


try{

const result =
await db
.from('profiles')
.insert({
id:user.id,
display_name:name,
username:username
});


if(!result.error){

data={
display_name:name,
username:username,
avatar_url:null
};

}else{

console.warn(
'Profile insert:',
result.error
);

data={
display_name:name,
username:username,
avatar_url:null
};

}

}catch(error){

console.error(
'Profile creation error:',
error
);

data={
display_name:name,
username:username,
avatar_url:null
};

}

}


document
.getElementById('profileName')
.textContent =
data.display_name || 'User';


document
.getElementById('profileUsername')
.textContent =
'@' + (data.username || 'user');


setAvatars(
data.avatar_url || FALLBACK
);


await loadFeed();

}


/* =====================================================
   FEED
===================================================== */

async function loadFeed(){

const user =
await currentUser();

if(!user){
return;
}


const box =
document.getElementById('feed');


const result =
await db
.from('posts')
.select(
'id,body,created_at'
)
.eq('user_id',user.id)
.order(
'created_at',
{
ascending:false
}
)
.limit(30);


if(
result.error ||
!result.data ||
!result.data.length
){

box.innerHTML =
`
<div class="empty card">

Wala ka pang post. ✨
<br>
Gumawa ng first post mo sa taas.

</div>
`;

return;

}


const profileName =
document
.getElementById('profileName')
.textContent;


const avatar =
document
.getElementById('homeAvatar')
.src;


box.innerHTML =
result.data
.map(post=>`

<article class="card">

<div class="head">

<img
class="avatar"
src="${esc(avatar)}"
alt="Avatar"
>

<div>

<div class="name">

${esc(profileName)} 🌈

</div>

<div class="time">

${formatDate(post.created_at)}

</div>

</div>

</div>

<div class="msg">

${esc(post.body)}

</div>

<div class="actions">

<button
onclick="like(this)">

☘ Nice

</button>

<button
onclick="toast('Comments coming next')">

💬 Comment

</button>

<button
onclick="toast('Share coming next')">

↗ Share

</button>

</div>

</article>

`)
.join('');

}


/* =====================================================
   DATE
===================================================== */

function formatDate(date){

if(!date){
return 'Just now · 🌐';
}


const d =
new Date(date);


if(Number.isNaN(d.getTime())){
return 'Just now · 🌐';
}


return d.toLocaleString(
'en-PH',
{
dateStyle:'medium',
timeStyle:'short'
}
);

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function esc(value){

return String(value ?? '')
.replace(
/[&<>'"]/g,
character=>({

'&':'&amp;',
'<':'&lt;',
'>':'&gt;',
"'":'&#39;',
'"':'&quot;'

}[character])
);

}


/* =====================================================
   PUBLISH
===================================================== */

async function publish(){

const text =
document
.getElementById('postText')
.value
.trim();


if(!text){

toast(
'Write something first'
);

return;

}


const user =
await currentUser();


if(!user){

toast(
'Session expired. Please login again.'
);

return;

}


const result =
await db
.from('posts')
.insert({
user_id:user.id,
body:text
});


if(result.error){

console.error(
'Post error:',
result.error
);

toast(
result.error.message
);

return;

}


document
.getElementById('postText')
.value='';


toast('Posted!');


await loadFeed();

}


/* =====================================================
   LIKE
===================================================== */

function like(button){

button.classList.toggle('liked');

toast(
button.classList.contains('liked')
?
'Nice added!'
:
'Nice removed!'
);

}


/* =====================================================
   LOGIN
===================================================== */

async function login(){

const email =
document
.getElementById('email')
.value
.trim();


const password =
document
.getElementById('password')
.value;


const message =
document
.getElementById('authMsg');


message.textContent='';


if(!email || !password){

message.textContent =
'Ilagay ang email at password.';

return;

}


const button =
document.getElementById('login');


button.disabled=true;
button.textContent='Logging in...';


try{

const result =
await db.auth.signInWithPassword({
email:email,
password:password
});


if(result.error){

message.textContent =
result.error.message;

return;

}


if(!result.data?.session){

message.textContent =
'Login failed: walang session na nakuha.';

return;

}


toast('Login successful!');


await showApp();


}catch(error){

console.error(
'Login error:',
error
);

message.textContent =
error.message ||
'Login failed.';

}finally{

button.disabled=false;
button.textContent='Login';

}

}


/* =====================================================
   SIGN UP
===================================================== */

async function signup(){

const email =
document
.getElementById('email')
.value
.trim();


const password =
document
.getElementById('password')
.value;


const name =
document
.getElementById('displayName')
.value
.trim() ||
'User';


const message =
document
.getElementById('authMsg');


message.textContent='';


if(!email || !password){

message.textContent =
'Ilagay ang email at password.';

return;

}


if(password.length < 6){

message.textContent =
'Password must be at least 6 characters.';

return;

}


const button =
document.getElementById('signup');


button.disabled=true;
button.textContent='Creating...';


try{

const result =
await db.auth.signUp({

email:email,

password:password,

options:{
data:{
display_name:name
}
}

});


if(result.error){

message.textContent =
result.error.message;

return;

}


if(result.data?.session){

toast(
'Account created!'
);

await showApp();

}else{

message.textContent =
'Account created. Check your email to confirm your account before logging in.';

}

}catch(error){

console.error(
'Signup error:',
error
);

message.textContent =
error.message ||
'Signup failed.';

}finally{

button.disabled=false;
button.textContent='Create Account';

}

}


/* =====================================================
   LOGOUT
===================================================== */

async function logout(){

try{

await db.auth.signOut();

}catch(error){

console.error(
'Logout error:',
error
);

}


document
.getElementById('app')
.classList.add('hide');


document
.getElementById('auth')
.classList.remove('hide');


document
.getElementById('password')
.value='';


document
.getElementById('authMsg')
.textContent='';


toast('Logged out');

}


/* =====================================================
   SHOW APP
===================================================== */

async function showApp(){

document
.getElementById('auth')
.classList.add('hide');


document
.getElementById('app')
.classList.remove('hide');


await loadProfile();

}


/* =====================================================
   PROFILE PHOTO
===================================================== */

document
.getElementById('profileUpload')
.addEventListener(
'change',
async event=>{

const file =
event.target.files?.[0];


if(!file){
return;
}


const user =
await currentUser();


if(!user){

toast(
'Please login again.'
);

return;

}


if(
!file.type.startsWith('image/') ||
file.size > 5 * 1024 * 1024
){

toast(
'Image must be under 5MB'
);

return;

}


const extension =
(
file.name
.split('.')
.pop() ||
'jpg'
)
.toLowerCase()
.replace(
/[^a-z0-9]/g,
''
);


const path =
`${user.id}/profile-${Date.now()}.${extension}`;


toast(
'Uploading...'
);


try{

const upload =
await db.storage
.from('avatars')
.upload(
path,
file,
{
contentType:file.type,
upsert:false,
cacheControl:'3600'
}
);


if(upload.error){

toast(
'Upload failed: ' +
upload.error.message
);

return;

}


const publicUrl =
db.storage
.from('avatars')
.getPublicUrl(path)
.data.publicUrl;


const update =
await db
.from('profiles')
.update({
avatar_url:publicUrl
})
.eq('id',user.id);


if(update.error){

toast(
'Profile update failed: ' +
update.error.message
);

return;

}


setAvatars(
publicUrl
);


toast(
'Profile picture updated!'
);


}catch(error){

console.error(
'Upload error:',
error
);

toast(
'Upload failed.'
);

}

event.target.value='';

});


/* =====================================================
   BUTTONS
===================================================== */

document
.getElementById('login')
.onclick=login;


document
.getElementById('signup')
.onclick=signup;


/* ENTER TO LOGIN */

document
.getElementById('password')
.addEventListener(
'keydown',
event=>{

if(event.key===
